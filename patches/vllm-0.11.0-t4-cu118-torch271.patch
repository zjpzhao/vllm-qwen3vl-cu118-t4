diff --git a/CMakeLists.txt b/CMakeLists.txt
index 180b896..9b7606b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -168,6 +168,28 @@ endif()
 #
 get_torch_gpu_compiler_flags(VLLM_GPU_FLAGS ${VLLM_GPU_LANG})
 
+# CUDA 11.x compatibility for Turing-only builds.  FindCUDA exposes the
+# toolkit version through CUDA_VERSION; CMAKE_CUDA_COMPILER_VERSION is not set
+# in this build path, so do not use it for this check.
+if(VLLM_GPU_LANG STREQUAL "CUDA" AND CUDA_VERSION VERSION_LESS 12.0)
+  # Link against the toolkit's driver stub while building.  Some headless
+  # build hosts expose a placeholder libcuda.so; linking that file drops the
+  # libcuda.so.1 DT_NEEDED entry and leaves driver symbols unresolved.
+  set(VLLM_CUDA_DRIVER_STUB
+      "${CUDA_TOOLKIT_ROOT_DIR}/lib/stubs/libcuda.so")
+  if(TARGET CUDA::cuda_driver AND EXISTS "${VLLM_CUDA_DRIVER_STUB}")
+    set_property(TARGET CUDA::cuda_driver PROPERTY
+      IMPORTED_LOCATION "${VLLM_CUDA_DRIVER_STUB}")
+  endif()
+
+  list(APPEND VLLM_GPU_FLAGS
+    "-U__CUDA_NO_HALF_OPERATORS__"
+    "-U__CUDA_NO_HALF_CONVERSIONS__"
+    "-U__CUDA_NO_BFLOAT16_CONVERSIONS__"
+    "-U__CUDA_NO_HALF2_OPERATORS__"
+    "-DVLLM_CUDA11_COMPAT=1")
+endif()
+
 #
 # Set nvcc parallelism.
 #
