+            if self.use_t4_contiguous_prefill:
+                # Triton 3.3 cannot lower the vLLM/FlexAttention FP16 dot
+                # kernels for SM75. Embedding requests are pure prefills, so
+                # use the current contiguous Q/K/V tensors with xFormers'
+                # precompiled CUTLASS kernel and avoid paged Triton attention.
+                # Prefix caching and chunked prefill must be disabled so that
+                # every KV token needed by a request is present in key/value.
+                q_seqlens = torch.diff(prefill_meta.query_start_loc)
+                if not torch.equal(q_seqlens, prefill_meta.seq_lens):
+                    raise RuntimeError(
+                        "VLLM_T4_XFORMERS_CONTIGUOUS_PREFILL requires "
+                        "prefix caching and chunked prefill to be disabled")
+                if self.sliding_window != (-1, -1):
+                    raise RuntimeError(
+                        "VLLM_T4_XFORMERS_CONTIGUOUS_PREFILL does not "
+                        "support sliding-window attention")
+                if self.logits_soft_cap != 0:
+                    raise RuntimeError(
+                        "VLLM_T4_XFORMERS_CONTIGUOUS_PREFILL does not "
+                        "support logits soft cap")
+
+                prefill_query = query[num_decode_tokens:num_actual_tokens]
+                prefill_key = key[num_decode_tokens:num_actual_tokens]
+                prefill_value = value[num_decode_tokens:num_actual_tokens]
+                q = prefill_query.view(1, -1, self.num_kv_heads,
+                                       self.num_queries_per_kv,
+                                       self.head_size)
+                k = prefill_key.view(1, -1, self.num_kv_heads, 1,
+                                     self.head_size).expand(
+                                         -1, -1, -1,
+                                         self.num_queries_per_kv, -1)
+                v = prefill_value.view(1, -1, self.num_kv_heads, 1,
+                                       self.head_size).expand(
+                                           -1, -1, -1,
+                                           self.num_queries_per_kv, -1)
+                attn_bias = BlockDiagonalCausalMask.from_seqlens(
+                    q_seqlens.tolist(), device=query.device)
+                output[num_decode_tokens:num_actual_tokens] = (
+                    xops.memory_efficient_attention_forward(
+                        q,
+                        k,
+                        v,
+                        attn_bias=attn_bias,
+                        p=0.0,
+                        scale=self.scale,
+                        op=xformers_cutlass.FwOp,
+                    ).view(prefill_query.shape))
+            else:
+                descale_shape = (prefill_meta.query_start_loc.shape[0] - 1,
